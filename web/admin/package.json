{
  "name": "kasmos-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test:unit": "tsx src/api.test.ts && tsx src/hooks/useAutoRefresh.test.ts && tsx src/pages/agentCardModel.test.ts && node --import ./src/css-mock-loader.mjs --import tsx/esm src/components/TerminalPreview.test.tsx",
    "test:dom": "vitest run",
    "test": "npm run test:unit && npm run test:dom",
    "build": "tsc -b && npm run test && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@uiw/react-md-editor": "^4.1.0",
    "ansi_up": "^6.0.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
