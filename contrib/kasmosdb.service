[Unit]
Description=kasmos plan store server
Documentation=https://github.com/kastheco/kasmos
After=network.target kasmos.service

[Service]
Type=simple
# example: ExecStart=%h/go/bin/kas serve --repo %h/dev/kasmos
ExecStart=%h/go/bin/kas serve
Restart=on-failure
RestartSec=5
Environment=HOME=%h

[Install]
WantedBy=default.target
