# Template: __KAS_BIN__ must be replaced with the absolute path to the installed
# kas binary before enabling this unit. Use `just db-service-install` (which runs
# `command -v kas` and substitutes the placeholder automatically) or substitute
# manually: sed "s|__KAS_BIN__|$(command -v kas)|g" contrib/kasmosdb.service > ~/.config/systemd/user/kasmosdb.service

[Unit]
Description=kasmos plan store server
Documentation=https://github.com/kastheco/kasmos
After=network.target kasmos.service

[Service]
Type=simple
# example: ExecStart=__KAS_BIN__ serve --repo /home/you/dev/kasmos
ExecStart=__KAS_BIN__ serve
KillSignal=SIGTERM
TimeoutStopSec=15
Restart=on-failure
RestartSec=5
Environment=HOME=%h

[Install]
WantedBy=default.target
