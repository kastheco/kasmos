{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "architect": {
      "model": "openai/gpt-5.4",
      "permission": {
        "bash": "allow",
        "edit": {
          "*": "ask",
          "/tmp/*": "allow",
          "/tmp/**": "allow"
        },
        "external_directory": {
          "*": "ask",
          "/home/kas/.config/opencode/*": "allow",
          "/home/kas/.config/opencode/**": "allow",
          "/home/kas/dev/kasmos/*": "allow",
          "/home/kas/dev/kasmos/**": "allow",
          "/tmp/*": "allow",
          "/tmp/**": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "read": "allow",
        "write": {
          "*": "ask",
          "/tmp/*": "allow",
          "/tmp/**": "allow"
        }
      },
      "reasoningEffort": "high",
      "temperature": 0.2,
      "textVerbosity": "medium"
    },
    "coder": {
      "model": "openai/gpt-5.3-codex-spark",
      "permission": {
        "bash": "allow",
        "edit": "allow",
        "external_directory": {
          "*": "ask",
          "/home/kas/.config/opencode/*": "allow",
          "/home/kas/.config/opencode/**": "allow",
          "/home/kas/dev/kasmos/*": "allow",
          "/home/kas/dev/kasmos/**": "allow",
          "/tmp/*": "allow",
          "/tmp/**": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "read": "allow",
        "write": "allow"
      },
      "reasoningEffort": "low",
      "temperature": 0.1,
      "textVerbosity": "low"
    },
    "fixer": {
      "model": "openai/gpt-5.4",
      "permission": {
        "bash": "allow",
        "edit": "allow",
        "external_directory": {
          "*": "ask",
          "/home/kas/.config/opencode/*": "allow",
          "/home/kas/.config/opencode/**": "allow",
          "/home/kas/dev/kasmos/*": "allow",
          "/home/kas/dev/kasmos/**": "allow",
          "/tmp/*": "allow",
          "/tmp/**": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "read": "allow",
        "write": "allow"
      },
      "reasoningEffort": "high",
      "temperature": 0.1,
      "textVerbosity": "low"
    }
  },
  "mcp": {
    "kasmos": {
      "enabled": true,
      "type": "remote",
      "url": "http://127.0.0.1:7434/mcp"
    }
  }
}
